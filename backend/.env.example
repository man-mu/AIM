# ============================================================
# 基础设施容器（docker compose 使用）
# ============================================================

# PostgreSQL
POSTGRES_DB=aim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Nacos 鉴权 (Token 需为 Base64 字符串)
NACOS_AUTH_TOKEN=YWltLW5hY29zLXNrZWxldG9uLWF1dGgtc2VjcmV0LWtleS0yMDI2LTAxMjM0NTY3ODk=
NACOS_AUTH_IDENTITY_KEY=aim-server
NACOS_AUTH_IDENTITY_VALUE=aim-security

# ============================================================
# 微服务运行时（mvn spring-boot:run / 容器启动时使用）
#   dev 环境有内置默认值，可不设；test/prod 必须显式注入
# ============================================================

# --- Spring Profile ---
# dev / test / prod，默认 dev
SPRING_PROFILES_ACTIVE=dev

# --- Nacos 连接 ---
NACOS_ADDR=localhost:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# namespace 与 group 一般 dev/test/prod 三选一
NACOS_NAMESPACE=dev
NACOS_GROUP=AIM_GROUP

# --- 数据源（test/prod 必填，dev 默认 localhost） ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis（test/prod 必填，dev 默认 localhost:6379） ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT 密钥（prod 强制必须，dev/test 有兜底默认值） ---
# 生产环境务必换一个足够长的随机字符串
JWT_SECRET=aim-jwt-secret-key-change-in-production

# --- Dubbo 注册中心（默认与 Nacos 共用，可独立配置） ---
NACOS_REGISTRY=localhost:8848
