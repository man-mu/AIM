# ============================================================
# 基础设施容器（docker compose 使用）
# ============================================================

# PostgreSQL
POSTGRES_DB=aim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka（容器化微服务连接时设为 kafka:9092；宿主机直连保持默认 localhost:9092）
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Nacos 鉴权 (Token 需为 Base64 字符串)
NACOS_AUTH_TOKEN=YWltLW5hY29zLXNrZWxldG9uLWF1dGgtc2VjcmV0LWtleS0yMDI2LTAxMjM0NTY3ODk=
NACOS_AUTH_IDENTITY_KEY=aim-server
NACOS_AUTH_IDENTITY_VALUE=aim-security

# ============================================================
# 微服务运行时（mvn spring-boot:run / 容器启动时使用）
# 仅微服务连接 Nacos 所需的 bootstrap 参数；业务配置全部走 Nacos
# ============================================================

# --- Nacos 连接 ---
NACOS_ADDR=localhost:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# namespace 决定从哪个环境拿配置：dev / test / prod
NACOS_NAMESPACE=dev
NACOS_GROUP=AIM_GROUP